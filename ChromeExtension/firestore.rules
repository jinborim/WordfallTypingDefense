rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /nicknames/{nicknameId} {
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'uid',
          'nickname',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid',
          'nickname',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.uid is string
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.updatedAt is timestamp;

      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.nickname == resource.data.nickname
        && request.resource.data.keys().hasOnly([
          'uid',
          'nickname',
          'updatedAt'
        ])
        && request.resource.data.updatedAt is timestamp;

      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    match /announcements/{announcementId} {
      allow read: if resource.data.isActive == true;
      allow write: if false;
    }

    match /appConfig/{configId} {
      // Update metadata is public read-only configuration. The client must
      // be able to check it before login, including when the document is not
      // present yet.
      allow get: if configId == 'update';
      allow list: if false;
      allow write: if false;
    }
  }
}
