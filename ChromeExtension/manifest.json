{
  "manifest_version": 3,
  "name": "Wordfall",
  "version": "1.0.0",
  "description": "Pixel typing defense game",
  "action": {
    "default_title": "Wordfall"
  },
  "permissions": [
    "offscreen",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; frame-src https://typing-c9b14.web.app"
  }
}
